# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Replicate AI Configuration
# Get your API token from https://replicate.com/account
REPLICATE_API_TOKEN=r8_your_token_here

# Yookassa Payment Configuration (Optional)
# Get these from your Yookassa merchant dashboard
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Application URL
# Used for payment redirects and webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000
